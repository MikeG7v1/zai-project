NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://zai:zai@localhost:5432/zai
# true for cloud databases that require TLS (e.g. Neon)
DATABASE_SSL=false
# true when the app runs behind a reverse proxy (e.g. Render)
TRUST_PROXY=false
# true in production: redirect http -> https
FORCE_HTTPS=false
TOKEN_TTL_SECONDS=3600

# Used by the create-admin and ensure-admin scripts
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

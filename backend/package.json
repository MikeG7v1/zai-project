{
  "name": "zai-backend",
  "version": "0.1.0",
  "description": "REST API of an application for collecting and presenting measurement series",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "create-admin": "node src/scripts/create-admin.js",
    "ensure-admin": "node src/scripts/ensure-admin.js",
    "start:prod": "npm run migrate && npm run ensure-admin && npm start"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "knex": "^3.3.0",
    "pg": "^8.23.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
